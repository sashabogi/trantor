{
  "name": "trantor",
  "version": "0.17.75",
  "description": "Trantor — the hub-world for AI agent crews: live message bus, presence, project Kanban/flow board + crew orchestration for independent AI coding agents (Claude, Codex, Gemini, Kimi, DeepSeek). This manifest makes Kimi Code CLI a first-class ORCHESTRATOR, mirroring .claude-plugin/plugin.json. Hooks are the CANONICAL hooks/** executed through the kimi dialect bridge (kimi/bridge.mjs) — docs/KIMI-BRIDGE-CONTRACT.md.",
  "interface": {
    "displayName": "Trantor",
    "shortDescription": "Multi-agent crew orchestration: bus, board, Advisor, Scrooge — Kimi as orchestrator",
    "developerName": "sashabogi",
    "websiteURL": "https://github.com/sashabogi/trantor"
  },
  "skills": "./kimi/skills/",
  "hooks": [
    {
      "event": "SessionStart",
      "command": "RELAY_AGENT=kimi-orch AGENT_CMD=kimi node ./kimi/bridge.mjs SessionStart ../hooks/sessionstart.mjs",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs UserPromptSubmit ../hooks/prompt-focus.mjs",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Agent|AgentSwarm",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs PreToolUse ../hooks/subagent-start.mjs",
      "timeout": 10
    },
    {
      "event": "SubagentStart",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs SubagentStart ../hooks/subagent-start.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "command": "RELAY_AGENT=kimi-orch AGENT_CMD=kimi node ./kimi/bridge.mjs PostToolUse ../hooks/heartbeat.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs PostToolUse ../hooks/inbox-deliver.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "TodoList",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs PostToolUse ../hooks/todo-sync.mjs",
      "timeout": 10
    },
    {
      "event": "PreCompact",
      "command": "RELAY_AGENT=kimi-orch AGENT_CMD=kimi node ./kimi/bridge.mjs PreCompact ../hooks/precompact.mjs",
      "timeout": 120
    },
    {
      "event": "Notification",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs Notification ../hooks/agent-notify.mjs",
      "timeout": 10
    },
    {
      "event": "SubagentStop",
      "command": "RELAY_AGENT=kimi-orch node ./kimi/bridge.mjs SubagentStop ../hooks/subagent-cost.mjs",
      "timeout": 30
    }
  ]
}
