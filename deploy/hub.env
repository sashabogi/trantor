# trantor hub env — deployed on netcup (Debian 13)
# Bind to the tailnet IP so agents on other machines can reach the hub.
# Non-loopback bind FORCES RELAY_AUTH=enforce (hub.mjs will exit otherwise).
RELAY_HOST=100.79.242.104
RELAY_PORT=4477
RELAY_AUTH=enforce
RELAY_ENROLL=invite

# Persistent data directory (separate volume, survives restarts)
RELAY_DATA_DIR=/var/lib/trantor/data

# TIME-based retention — events older than this (ms) are pruned.
# 30 days = 30 × 86400 × 1000
RELAY_EVENT_RETENTION_MS=2592000000

# Unbounded-log guard — cap total events regardless of age
RELAY_EVENT_CAP=50000

# Peer TTL: how long after last heartbeat before a peer is pruned (24h)
RELAY_PEER_TTL_MS=86400000

# Online window: a peer is "online" if last seen within this (5 min)
RELAY_ONLINE_MS=300000

# Stale-card reaper grace: card owner offline for 15 min → stale
RELAY_REAP_GRACE_MS=900000

# Postgres connection (set in /etc/trantor/env, never committed)
# DATABASE_URL=postgresql://trantor:<password>@127.0.0.1:5432/trantor
